# Environment Configuration Template for Language Translation Tool
# Copy this file to .env and fill in your actual configuration.
# DO NOT commit your actual .env file to version control.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
APP_ENV=development                # development | production | testing
PORT=5000                          # Port on which the application server runs
HOST=127.0.0.1                     # Host address (127.0.0.1 for local, 0.0.0.0 for containerized)
DEBUG=True                         # Enable/disable debug mode (False in production)

# -----------------------------------------------------------------------------
# Translation Provider Selection
# -----------------------------------------------------------------------------
# Supported values:
#   - dev_fallback  : Free development mock/fallback provider (explicitly labeled in UI, no API key required)
#   - google        : Google Cloud Translation API (Cloud Translation v2/v3)
#   - azure         : Microsoft Azure Translator (Cognitive Services)
#   - deepl         : DeepL API (Free or Pro)
#   - mymemory      : MyMemory Public Translation API (Free tier, no key or email registration)
TRANSLATION_PROVIDER=dev_fallback

# -----------------------------------------------------------------------------
# Google Cloud Translation API Configuration (Used when TRANSLATION_PROVIDER=google)
# -----------------------------------------------------------------------------
# Option A: API Key (Simple setup)
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here

# Option B: Service Account JSON path (Enterprise / Cloud setup)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# -----------------------------------------------------------------------------
# Microsoft Azure Translator Configuration (Used when TRANSLATION_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastus      # e.g., eastus, westeurope, global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# -----------------------------------------------------------------------------
# DeepL API Configuration (Used when TRANSLATION_PROVIDER=deepl)
# -----------------------------------------------------------------------------
# DeepL Free keys typically end with ':fx'
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_API_ENDPOINT=https://api-free.deepl.com/v2

# -----------------------------------------------------------------------------
# MyMemory API Configuration (Used when TRANSLATION_PROVIDER=mymemory)
# -----------------------------------------------------------------------------
# Optional email for higher rate limits (up to 50,000 words/day vs 5,000 without email)
MYMEMORY_EMAIL=user@example.com

# -----------------------------------------------------------------------------
# Security & Operational Limits
# -----------------------------------------------------------------------------
MAX_CHARACTERS_PER_REQUEST=5000    # Hard limit on input character count
REQUEST_TIMEOUT_SECONDS=10         # Upstream translation API timeout
RATE_LIMIT_PER_MINUTE=60           # Max translation requests per client IP per minute

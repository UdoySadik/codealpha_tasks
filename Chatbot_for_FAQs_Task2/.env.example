# ==============================================================================
# Environment Configuration Template: FAQ Chatbot
# Copy this file to '.env' if custom overrides are needed.
# NOTE: No external API keys or credentials are required. This system runs 100% locally.
# ==============================================================================

# Path to the FAQ knowledge base JSON file (relative or absolute)
FAQ_DATA_PATH="data/faqs.json"

# Minimum cosine similarity score (between 0.0 and 1.0) required to return a match.
# Queries scoring below this threshold will trigger the fallback response.
SIMILARITY_THRESHOLD=0.30

# Fallback response message when no question meets the threshold
DEFAULT_FALLBACK_MESSAGE="I'm sorry, but I couldn't find a sufficiently relevant answer in the FAQ database for your question. Could you please rephrase or reach out to student support?"

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
